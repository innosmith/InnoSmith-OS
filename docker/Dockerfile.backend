FROM python:3.12-slim

WORKDIR /app

# System-Dependencies:
#   libpq-dev/gcc     → asyncpg/psycopg Build
#   curl              → Health-Check im Container
#   libreoffice       → DOCX/PDF-Konvertierung (contentConverter)
#   fonts-liberation  → Standard-Fonts fuer LibreOffice
#   gettext-base      → envsubst fuer Nanobot-Config-Generierung
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc curl \
    libreoffice-writer libreoffice-common fonts-liberation \
    gettext-base \
    && rm -rf /var/lib/apt/lists/*

# Python-Dependencies
COPY src/backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Pandoc-Symlink: contentConverter ruft pandoc als Subprocess auf
RUN PANDOC_PATH=$(python -c "import pypandoc; print(pypandoc.get_pandoc_path())") \
    && ln -sf "$PANDOC_PATH" /usr/local/bin/pandoc \
    && pandoc --version | head -1

# Node.js + Mermaid-CLI (mmdc): rendert ```mermaid-Bloecke in
# Word/PDF/PowerPoint-Exporten als PNG-Grafik statt als Code-Text.
#
# Chromium: Das Debian-Chromium-Paket ist ein nicht-offizieller Build mit
# aktiven DCHECKs und stuerzt auf dieser aarch64-Plattform (GX10) bereits beim
# Start mit SIGTRAP ab. Stattdessen wird -- wie auf dem Host bereits bewaehrt --
# Playwrights Chromium-Build verwendet, der auf arm64 zuverlaessig laeuft.
# mmdc/puppeteer startet dieses Binary direkt via executablePath.
# PUPPETEER_SKIP_DOWNLOAD verhindert zusaetzlich den Download eines gebuendelten
# (evtl. falsch-architektur) Puppeteer-Chromium.
ENV PUPPETEER_SKIP_DOWNLOAD=true \
    PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
RUN apt-get update && apt-get install -y --no-install-recommends \
      nodejs npm \
    && npm install -g @mermaid-js/mermaid-cli@10 \
    && pip install --no-cache-dir playwright \
    && python -m playwright install --with-deps chromium \
    && npm cache clean --force \
    && rm -rf /var/lib/apt/lists/* /root/.npm
# Puppeteer-Config: Playwright-Chromium + --no-sandbox (Container ohne User-Namespace).
# executablePath wird zur Build-Zeit aufgeloest (fixe Version im Image) und der
# Browser-Pfad world-lesbar gemacht (Container laeuft als uid 1000).
RUN CHROME_BIN="$(ls -d "$PLAYWRIGHT_BROWSERS_PATH"/chromium-*/chrome-linux/chrome | sort -V | tail -1)" \
    && test -x "$CHROME_BIN" \
    && printf '{"executablePath":"%s","args":["--no-sandbox","--disable-gpu","--disable-dev-shm-usage"]}\n' "$CHROME_BIN" \
      > /etc/puppeteer-config.json \
    && chmod 0644 /etc/puppeteer-config.json \
    && chmod -R a+rX "$PLAYWRIGHT_BROWSERS_PATH"
# mmdc-Wrapper: haengt die Puppeteer-Config automatisch an, da cconv mmdc ohne -p aufruft
RUN MMDC_BIN="$(command -v mmdc)" \
    && mv "$MMDC_BIN" "${MMDC_BIN}.real" \
    && printf '#!/bin/sh\nexec "%s.real" "$@" -p /etc/puppeteer-config.json\n' "$MMDC_BIN" > "$MMDC_BIN" \
    && chmod 0755 "$MMDC_BIN" \
    && node --version && test -x "${MMDC_BIN}.real" \
    && test -x "$(sed -n 's/.*"executablePath":"\([^"]*\)".*/\1/p' /etc/puppeteer-config.json)"

# Private Packages (via docker/build.sh nach vendor/ kopiert)
# [all] = pdf + anonymize + mcp + extract (Presidio, spaCy, GLiNER, Faker, …)
COPY src/backend/vendor/ /opt/vendor/
RUN if [ -d /opt/vendor/contentconverter ]; then \
      pip install --no-cache-dir -e "/opt/vendor/contentconverter[all]"; \
    fi

# AI9-Core (privates Schwester-Repo). Wird als normales (nicht-editable) Package
# installiert; die Laufzeit-Deps (httpx, cachetools, sqlalchemy, mcp) sind bereits
# ueber requirements.txt gedeckt. Fehlt es, bricht der Import in app/__init__.py.
RUN if [ -d /opt/vendor/ai9 ]; then \
      pip install --no-cache-dir "/opt/vendor/ai9"; \
    else \
      echo "FEHLER: /opt/vendor/ai9 fehlt -- 'make vendor' bzw. docker/build.sh zuerst ausfuehren." >&2; \
      exit 1; \
    fi

# NLP-Modelle fuer Anonymisierung vorabladen (vermeidet Laufzeit-Downloads)
# spaCy: de (Primaersprache) + en (Fallback)
RUN python -m spacy download de_core_news_lg \
    && python -m spacy download en_core_web_sm
# GLiNER PII-Modell in den HuggingFace-Cache laden
ENV HF_HOME=/opt/hf-cache
RUN python -c "from gliner import GLiNER; GLiNER.from_pretrained('urchade/gliner_multi_pii-v1')"

# Ab hier ohne Netz. ``from_pretrained`` verweist auf den Zweig ``main``, einen
# wandernden Zeiger -- die Bibliothek fragt darum bei jedem Laden bei HuggingFace
# nach, ob der zwischengespeicherte Stand noch der aktuelle ist. Sinnlos, weil
# das Modell seit der Zeile darüber fest im Abbild liegt, und teuer: Gemessen im
# Cockpit-Backend kostet der Kaltstart der Erkennung mit Netz 13.1 s, ohne 8.5 s.
# Die 4.5 Sekunden schwanken mit der Netzlatenz.
ENV HF_HUB_OFFLINE=1

# Backend-Quellcode
COPY src/backend/app/ /app/app/

# Alembic (DB-Migrationen muessen im Container ausfuehrbar sein)
COPY src/backend/alembic.ini /app/
COPY src/backend/migrations/ /app/migrations/

# MCP-Server
COPY src/mcp-taskpilot/ /app/mcp-taskpilot/
COPY src/mcp-capacity/ /app/mcp-capacity/
COPY src/mcp-graph/ /app/mcp-graph/
COPY src/mcp-pipedrive/ /app/mcp-pipedrive/
COPY src/mcp-toggl/ /app/mcp-toggl/
COPY src/mcp-bexio/ /app/mcp-bexio/
COPY src/mcp-signa/ /app/mcp-signa/
COPY src/mcp-invoiceinsight/ /app/mcp-invoiceinsight/
COPY src/mcp-scripts/ /app/mcp-scripts/
COPY src/mcp-sandbox/ /app/mcp-sandbox/
COPY src/mcp-datenraum/ /app/mcp-datenraum/

# Shared Libraries
COPY src/email-graph/ /app/email-graph/
COPY src/pipedrive/ /app/pipedrive/
COPY src/bexio/ /app/bexio/
COPY src/toggl/ /app/toggl/
COPY src/signa/ /app/signa/
COPY src/capacity/ /app/capacity/

# Gepflegte Stammdaten: welche Kennungen in Bexio, Toggl und Pipedrive dieselbe
# Kundschaft meinen. Ohne diese Datei findet der Datenraum zu keiner Kundschaft
# etwas -- und zwar lautlos, weil eine fehlende Zuordnung eine leere Menge ergibt.
COPY docs/kundenschluessel.yaml /app/docs/kundenschluessel.yaml

ENV PYTHONPATH=/app:/app/email-graph:/app/pipedrive:/app/bexio:/app/toggl:/app/signa:/app/capacity

# Entrypoint (Hermes-Config wird zur Laufzeit vom Backend generiert)
COPY docker/entrypoint.sh /app/
RUN chmod +x /app/entrypoint.sh

# Template-Pfade (ueberschreibbar via env)
ENV TP_CONTENTCONVERTER_PATH=/opt/vendor/contentconverter
ENV TP_CONTENTCONVERTER_CCONV_BIN=/usr/local/bin/cconv
ENV CONTENTCONVERTER_TEMPLATE_DIR=/opt/vendor/contentconverter/templates

RUN apt-get update && apt-get install -y --no-install-recommends gosu && rm -rf /var/lib/apt/lists/*

RUN useradd -m -d /home/taskpilot -u 1000 -s /usr/sbin/nologin taskpilot && \
    mkdir -p /app/uploads/avatars /app/uploads/tasks /app/uploads/backgrounds /app/uploads/projects \
             /tmp/taskpilot-exports /home/taskpilot/.hermes && \
    chown -R taskpilot:taskpilot /app /tmp/taskpilot-exports /home/taskpilot /opt/hf-cache

EXPOSE 8000
ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
