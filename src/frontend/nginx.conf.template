server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 20m;

    # Docker-interner DNS-Resolver. Zusammen mit variablem proxy_pass (siehe unten)
    # loest nginx die Backend-IP zur Laufzeit neu auf, statt sie beim Start zu cachen.
    # Verhindert 502 (Connection refused), wenn das Backend nach dem Frontend neu
    # erstellt wird und eine neue Container-IP bekommt (z. B. bei `make prod`).
    resolver 127.0.0.11 valid=10s ipv6=off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ^~ /api/ {
        # Variabler Upstream -> Laufzeit-Aufloesung via resolver (kein Start-Caching).
        set $backend_upstream http://${BACKEND_HOST}:8000;
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_connect_timeout 60s;
        proxy_send_timeout 900s;
        proxy_read_timeout 900s;

        proxy_buffering off;
        proxy_cache off;

        gzip off;

        add_header X-Accel-Buffering no always;
    }

    location ^~ /uploads/ {
        set $uploads_upstream http://${BACKEND_HOST}:8000;
        proxy_pass $uploads_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Service Worker, App-Shell und Manifest NIE langlebig cachen. Sonst prueft der
    # Browser sw.js nie neu, der alte Workbox-Precache bleibt aktiv und verweist auf
    # geloeschte Chunk-Hashes -> «Failed to fetch dynamically imported module».
    # Muss vor der generischen Asset-Regel stehen (exakte Matches gewinnen).
    location = /sw.js {
        add_header Cache-Control "no-cache, must-revalidate" always;
        expires off;
    }

    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate" always;
        expires off;
    }

    location = /manifest.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-cache, must-revalidate" always;
        expires off;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires off;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    gzip on;
    gzip_vary on;
    gzip_min_length 256;
    gzip_proxied any;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        image/svg+xml;
}
